<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Metrics" Version="5.6.0" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <Reference Include="Metrics"><HintPath>$(PkgMicrosoft_CodeAnalysis_Metrics)/Metrics/Metrics.exe</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(PkgMicrosoft_CodeAnalysis_Metrics)/Metrics/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(PkgMicrosoft_CodeAnalysis_Metrics)/Metrics/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
